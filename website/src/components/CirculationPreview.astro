---
interface Props { english: boolean; headphones: string }
const { english, headphones } = Astro.props;
const routes = [
	{
		id: 'xiaomi',
		title: english ? 'Xiaomi HyperConnect' : '小米互联',
		via: english ? 'Fusion Device Center' : '融合设备中心',
		from: english ? 'HyperOS phone A' : 'HyperOS 手机 A',
		to: english ? 'HyperOS phone B' : 'HyperOS 手机 B',
	},
	{
		id: 'openrose',
		title: english ? 'OpenRose over LAN' : 'OpenRose 互联',
		via: english ? 'Local network pairing' : '局域网流转配对',
		from: english ? 'Xiaomi 14' : '小米 14',
		to: english ? 'Linux PC' : 'Linux 电脑',
	},
];
---

<div class="circulation">
	{routes.map(({ id, title, via, from, to }) => (
		<div class="route" data-route={id}>
			<div class="heading">
				<strong>{title}</strong>
				<span>{via}</span>
			</div>
			<div class="diagram">
				<div class="track">
					<span class="marker"><img src={headphones} alt="" /></span>
				</div>
				{[from, to].map((name, index) => (
					<div class="endpoint">
						<span class:list={['device', id === 'openrose' && index === 1 ? 'laptop' : 'phone']}></span>
						<span>{name}</span>
					</div>
				))}
			</div>
		</div>
	))}
</div>

<style>
	.circulation {
		container-type: size;
		display: grid;
		grid-template-rows: 1fr 1fr;
		width: 100%;
		height: 100%;
		color: #fff;
		background: radial-gradient(ellipse at 15% 0, #484b61, transparent 66%),
			radial-gradient(ellipse at 90% 100%, #55404c, transparent 70%), #292834;
	}
	.route {
		--accent: #adc9ff;
		--screen: #586c99;
		--device-height: min(31cqw, 20cqh);
		display: grid;
		align-content: center;
		gap: clamp(0.75rem, 3.5cqh, 1.25rem);
		margin-inline: 7cqw;
	}
	.route[data-route='openrose'] {
		--accent: #ffc2cf;
		--screen: #925f73;
		border-top: 1px solid #ffffff29;
	}
	.heading { display: grid; gap: 0.12rem; line-height: 1.3; }
	.heading strong { font-size: clamp(1.2rem, 5cqw, 1.65rem); letter-spacing: -0.02em; }
	.heading span { color: var(--accent); font-size: clamp(0.75rem, 2.8cqw, 0.9rem); }
	.diagram {
		position: relative;
		display: grid;
		grid-template-columns: 40% 40%;
		justify-content: space-between;
	}
	.endpoint {
		z-index: 1;
		display: grid;
		grid-template-rows: var(--device-height) auto;
		place-items: center;
		gap: 0.55rem;
		font-size: clamp(0.75rem, 3cqw, 0.95rem);
		text-align: center;
		text-wrap: balance;
		line-height: 1.25;
	}
	.device {
		position: relative;
		box-sizing: border-box;
		background: linear-gradient(138deg, #c2bac4, #58565f 35%, #88828f 85%, #d2c7cb);
		box-shadow: 0 0.45rem 0.65rem #17152159;
	}
	.device::before {
		content: '';
		position: absolute;
		inset: 2px;
		border: 2px solid #25232c;
		border-radius: inherit;
		background: radial-gradient(ellipse at 94% 90%, var(--screen) 0% 40%, transparent 41%),
			linear-gradient(140deg, var(--screen), #322f40 72%);
	}
	.phone {
		height: var(--device-height);
		aspect-ratio: 0.49;
		border-radius: calc(var(--device-height) * 0.09);
	}
	.phone::after {
		content: '';
		position: absolute;
		top: 6%;
		left: 50%;
		translate: -50% 0;
		width: 4px;
		aspect-ratio: 1;
		border-radius: 50%;
		background: #24222c;
	}
	.laptop {
		width: min(94%, calc(var(--device-height) * 1.32));
		aspect-ratio: 1.58;
		border-radius: 5px 5px 2px 2px;
	}
	.laptop::after {
		content: '';
		position: absolute;
		inset: 100% -7% auto;
		height: 8%;
		border-radius: 1px 1px 50% 50%;
		background: linear-gradient(#ccc2c9, #827d88);
	}
	.track {
		position: absolute;
		inset: calc(var(--device-height) / 2) 20% auto;
		height: 2px;
		background: repeating-linear-gradient(to right, var(--accent) 0 3px, transparent 3px 8px);
	}
	.track::after {
		content: '';
		position: absolute;
		left: 61%;
		top: 50%;
		width: 0.55rem;
		aspect-ratio: 1;
		border: solid var(--accent);
		border-width: 2px 2px 0 0;
		transform: translate(-50%, -50%) rotate(45deg);
	}
	.marker {
		position: absolute;
		z-index: 2;
		left: 100%;
		top: 50%;
		translate: -50% -50%;
		display: grid;
		place-items: center;
		width: clamp(1.85rem, 9cqw, 2.75rem);
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 0 3px #292834b3, 0 4px 8px #18162255;
	}
	.marker img { display: block; width: 72%; filter: brightness(0); opacity: 0.78; }
	[data-route='openrose'] .marker { left: 0; }
	[data-route='openrose'] .track::after {
		left: 39%;
		transform: translate(-50%, -50%) rotate(-135deg);
	}
	@media (prefers-reduced-motion: no-preference) {
		.marker {
			animation: move-connection 1.4s 0.7s cubic-bezier(.4, 0, .2, 1) both;
			animation-play-state: var(--showcase-play-state, running);
		}
		[data-route='openrose'] .marker {
			animation-delay: 2.6s;
			animation-direction: reverse;
		}
	}
	@keyframes move-connection { from { left: 0; } to { left: 100%; } }
</style>
