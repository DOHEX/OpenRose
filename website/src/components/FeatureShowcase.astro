---
import HighlightScene from './HighlightScene.astro';

interface Props { english: boolean }
const { english } = Astro.props;
const scenes = [
	{
		id: 'quick',
		label: english ? 'Quick panel' : '快捷面板',
		caption: english
			? 'Tap the OpenRose tile in Android Quick Settings, then choose 通透 (Transparency) in the quick panel.'
			: '点控制中心的 OpenRose 磁贴，在快捷面板的「降噪模式」里选择「通透」。',
	},
	{
		id: 'island',
		label: english ? 'System island' : '超级岛',
		caption: english
			? 'Expand the HyperOS battery island to see the charge and controls. This preview follows the module’s notification template.'
			: '展开 HyperOS 常驻电量岛，查看电量和操作按钮。画面按 OpenRose 模块的通知模板还原。',
	},
	{
		id: 'tray',
		label: english ? 'Desktop tray' : '桌面托盘',
		caption: english
			? 'On Linux, with background control on, open the tray panel to check each earbud’s charge and the selected noise mode.'
			: '在 Linux 上开启后台控制后，从托盘打开面板，就能查看左右耳电量和当前降噪模式。',
	},
] as const;
const play = english ? 'Play feature preview' : '播放亮点演示';
const pause = english ? 'Pause feature preview' : '暂停亮点演示';
---

<fieldset data-showcase class="showcase">
	<legend class="sr-only">{english ? 'OpenRose feature preview' : 'OpenRose 亮点演示'}</legend>
	{scenes.map(({ id, label, caption }, index) => (
		<Fragment>
			<input class="sr-only" type="radio" name="openrose-feature" id={'demo-' + id} value={id}
				aria-describedby={'caption-' + id} checked={index === 0} />
			<label class="choice" for={'demo-' + id}>{label}</label>
			<figure>
				<div class="art" aria-hidden="true"><HighlightScene scene={id} /></div>
				<figcaption id={'caption-' + id}>{caption}</figcaption>
			</figure>
		</Fragment>
	))}
	<button type="button" class="playback" data-play={play} data-pause={pause} aria-label={pause} title={pause} hidden>
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<path class="pause-icon" d="M7 5h3v14H7zm7 0h3v14h-3z" />
			<path class="play-icon" d="M7 4.5v15l12-7.5z" />
		</svg>
	</button>
</fieldset>

<script>
	for (const showcase of document.querySelectorAll<HTMLFieldSetElement>('[data-showcase]')) {
		const choices = Array.from(showcase.querySelectorAll<HTMLInputElement>('input[type=radio]'));
		const button = showcase.querySelector<HTMLButtonElement>('.playback')!;
		const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

		function setPlayback(state: 'auto' | 'manual' | 'paused') {
			showcase.dataset.playback = state;
			const label = state === 'auto' ? button.dataset.pause! : button.dataset.play!;
			button.setAttribute('aria-label', label);
			button.title = label;
		}

		function useMotionPreference() {
			button.hidden = reducedMotion.matches;
			setPlayback(reducedMotion.matches ? 'manual' : 'auto');
		}

		button.addEventListener('click', () => {
			setPlayback(showcase.dataset.playback === 'auto' ? 'paused' : 'auto');
		});
		for (const choice of choices) {
			choice.addEventListener('focus', () => setPlayback('manual'));
			choice.addEventListener('change', () => setPlayback('manual'));
		}
		// The selected label's progress line is the clock for automatic scene changes.
		showcase.addEventListener('animationend', (event) => {
			if (event.pseudoElement !== '::after' || !(event.target instanceof HTMLLabelElement)) return;
			const index = choices.findIndex((choice) => choice.checked);
			if (showcase.dataset.playback === 'auto' && event.target.htmlFor === choices[index].id) {
				choices[(index + 1) % choices.length].checked = true;
			}
		});

		let inView = false;
		function updateVisibility() {
			showcase.toggleAttribute('data-idle', document.hidden || !inView);
		}
		new IntersectionObserver(([entry]) => {
			inView = entry.isIntersecting;
			updateVisibility();
		}).observe(showcase);
		document.addEventListener('visibilitychange', updateVisibility);
		reducedMotion.addEventListener('change', useMotionPreference);
		updateVisibility();
		useMotionPreference();
	}
</script>

<style>
	.showcase {
		position: relative;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr)) auto;
		--showcase-play-state: running;
		--rotation-play-state: running;
		width: 100%;
		max-width: 37rem;
		min-width: 0;
		margin: 0 auto;
		padding: 0.375rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1.5rem;
		background: var(--sl-color-bg);
		box-shadow: 0 1.25rem 3.5rem -1.5rem rgb(53 19 42 / 35%);
	}
	.showcase[data-playback='paused'], .showcase[data-idle] {
		--rotation-play-state: paused;
		--showcase-play-state: paused;
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}
	figure {
		grid-column: 1 / -1;
		grid-row: 1 / 3;
		display: grid;
		grid-template-rows: subgrid;
		margin: 0;
		visibility: hidden;
	}
	input:checked + .choice + figure { visibility: visible; }
	.art {
		width: 100%;
		aspect-ratio: 0.55;
		max-height: 35rem;
		overflow: hidden;
		border-radius: 1.1rem;
		-webkit-touch-callout: none;
	}
	.art :global(img) { pointer-events: none; }
	/* Inactive captions still size the shared row. Only the selected scene runs its animation. */
	input:not(:checked) + .choice + figure .art > :global(*) { display: none; }
	figcaption {
		align-self: center;
		padding: 0.75rem 0.8rem 0.6rem;
		color: var(--sl-color-gray-2);
		font-size: 0.875rem;
		line-height: 1.5;
	}
	.choice, .playback {
		grid-row: 3;
		display: grid;
		place-items: center;
		min-height: 2.75rem;
		margin: 0.15rem;
		padding: 0.25rem;
		border-radius: 0.7rem;
		font: inherit;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.choice {
		position: relative;
		text-align: center;
		font-size: 0.8125rem;
		font-weight: 600;
		line-height: 1.2;
	}
	.choice:hover, .playback:hover { background: var(--sl-color-gray-6); }
	input:checked + .choice {
		color: var(--sl-color-accent-high);
		background: var(--sl-color-accent-low);
	}
	input:focus-visible + .choice, .playback:focus-visible {
		outline: 2px solid var(--sl-color-accent-high);
		outline-offset: 1px;
	}
	.showcase:is([data-playback='auto'], [data-playback='paused']) input:checked + .choice::after {
		content: '';
		position: absolute;
		inset: auto 12% 0.23rem;
		height: 2px;
		background: currentColor;
		border-radius: 1rem;
		transform-origin: left;
		animation: advance 6.5s linear both;
		animation-play-state: var(--rotation-play-state);
	}
	@keyframes advance {
		from { transform: scaleX(0); }
		to { transform: scaleX(1); }
	}
	.playback {
		grid-column: 4;
		width: 2.75rem;
		border: 0;
		background: transparent;
	}
	.playback svg { width: 1rem; fill: currentColor; }
	.playback[hidden], .play-icon { display: none; }
	.showcase:not([data-playback='auto']) .pause-icon { display: none; }
	.showcase:not([data-playback='auto']) .play-icon { display: inline; }
	@media (prefers-reduced-motion: reduce) {
		.choice::after { display: none; }
	}
</style>
