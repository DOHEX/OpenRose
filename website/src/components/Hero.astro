---
import { LinkButton } from '@astrojs/starlight/components';
import FeatureShowcase from './FeatureShowcase.astro';

const { data } = Astro.locals.starlightRoute.entry;
// Starlight's PAGE_TITLE_ID (not exported): target of the "skip to content" link.
const PAGE_TITLE_ID = '_top';
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<div class="hero">
	<div class="sl-flex stack">
		<div class="sl-flex copy">
			<h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
			{tagline && <div class="tagline" set:html={tagline} />}
		</div>
		{actions.length > 0 && (
			<div class="sl-flex actions">
				{actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
					<LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
						{text}
						{icon?.html && <Fragment set:html={icon.html} />}
					</LinkButton>
				))}
			</div>
		)}
	</div>
	<FeatureShowcase english={Astro.locals.starlightRoute.lang === 'en'} />
</div>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		align-items: center;
		gap: 2rem;
		padding-block: 1.5rem;
	}
	.stack, .copy {
		flex-direction: column;
		align-items: center;
		text-align: center;
	}
	.stack { gap: 1.5rem; }
	.copy { gap: 0.8rem; }
	h1 {
		font-size: clamp(var(--sl-text-4xl), 7vw, 5rem);
		line-height: 1.05;
		font-weight: 700;
		letter-spacing: -0.055em;
		color: var(--sl-color-white);
	}
	.tagline {
		max-width: 44ch;
		font-size: clamp(var(--sl-text-base), 1.5vw, var(--sl-text-xl));
		color: var(--sl-color-gray-2);
	}
	.actions {
		gap: 0.75rem 1.25rem;
		flex-wrap: wrap;
		justify-content: center;
	}
	.actions :global(.sl-link-button.primary) {
		background: linear-gradient(135deg, oklch(74% 0.15 12), oklch(66% 0.19 10));
		border-color: transparent;
		color: #32101b;
		box-shadow: 0 6px 24px -6px oklch(60% 0.22 12 / 0.4);
	}
	@media (min-width: 50rem) {
		.hero {
			grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
			gap: clamp(2rem, 4vw, 4rem);
			padding-block: clamp(2.5rem, 7vh, 5.5rem);
		}
		.stack, .copy { align-items: flex-start; text-align: start; }
		.actions { justify-content: flex-start; }
	}
</style>
