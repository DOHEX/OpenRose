---
import { LinkButton } from '@astrojs/starlight/components';

const { data } = Astro.locals.starlightRoute.entry;
// Starlight's PAGE_TITLE_ID (not exported): target of the "skip to content" link.
const PAGE_TITLE_ID = '_top';
const { title = data.title, tagline, actions = [] } = data.hero || {};

const headphonePath =
	'M280 840h-80q-33 0-56.5-23.5T120 760v-280q0-75 28.5-140.5t77-114q48.5-48.5 114-77T480 120q75 0 140.5 28.5t114 77q48.5 48.5 77 114T840 480v280q0 33-23.5 56.5T760 840h-80q-33 0-56.5-23.5T600 760v-160q0-33 23.5-56.5T680 520h80v-40q0-117-81.5-198.5T480 200q-117 0-198.5 81.5T200 480v40h80q33 0 56.5 23.5T360 600v160q0 33-23.5 56.5T280 840Zm0-240h-80v160h80v-160Zm400 0v160h80v-160h-80Z';
const bars = Array.from({ length: 9 }, (_, i) => i);
---

<div class="hero">
	<div class="backdrop" aria-hidden="true">
		<span class="blob blob-a"></span>
		<span class="blob blob-b"></span>
		<span class="spotlight"></span>
	</div>

	<div class="visual" aria-hidden="true">
		<svg viewBox="0 0 512 512" fill="none">
			<defs>
				<linearGradient id="hero-primary" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0%" stop-color="#fda4af" />
					<stop offset="55%" stop-color="#fb7185" />
					<stop offset="100%" stop-color="#f43f5e" />
				</linearGradient>
				<radialGradient id="hero-glow">
					<stop offset="0%" stop-color="#fb7185" stop-opacity="0.35" />
					<stop offset="100%" stop-color="#fb7185" stop-opacity="0" />
				</radialGradient>
			</defs>
			<circle cx="256" cy="256" r="240" fill="url(#hero-glow)" />
			<circle class="pulse" cx="256" cy="256" r="150" />
			<circle class="pulse" cx="256" cy="256" r="150" style="animation-delay: -1.2s" />
			<circle class="pulse" cx="256" cy="256" r="150" style="animation-delay: -2.4s" />
			<circle class="orbit" cx="256" cy="256" r="212" />
			<circle class="orbit-dot" cx="256" cy="44" r="5" />
			<g class="phones">
				<path transform="translate(112 96) scale(0.3)" d={headphonePath} fill="url(#hero-primary)" />
			</g>
			<g class="eq" transform="translate(196 392)">
				{bars.map((i) => <rect class="bar" x={i * 14} y="-36" width="7" height="36" rx="3.5" style={`animation-delay: ${-(i * 0.17).toFixed(2)}s`} />)}
			</g>
		</svg>
	</div>

	<div class="sl-flex stack">
		<div class="sl-flex copy">
			<h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
			{tagline && <div class="tagline" set:html={tagline} />}
		</div>
		{actions.length > 0 && (
			<div class="sl-flex actions">
				{actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
					<LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
						{text}
						{icon?.html && <Fragment set:html={icon.html} />}
					</LinkButton>
				))}
			</div>
		)}
	</div>
</div>

<script>
	const hero = document.querySelector<HTMLElement>('.hero');
	if (hero && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		hero.addEventListener('pointermove', (e) => {
			const r = hero.getBoundingClientRect();
			hero.style.setProperty('--mx', `${e.clientX - r.left}px`);
			hero.style.setProperty('--my', `${e.clientY - r.top}px`);
			hero.style.setProperty('--tilt-x', `${((e.clientY - r.top) / r.height - 0.5) * -8}deg`);
			hero.style.setProperty('--tilt-y', `${((e.clientX - r.left) / r.width - 0.5) * 8}deg`);
		});
		hero.addEventListener('pointerleave', () => {
			hero.style.setProperty('--tilt-x', '0deg');
			hero.style.setProperty('--tilt-y', '0deg');
		});
	}
</script>

<style>
	.hero {
		--rose: oklch(72% 0.17 12);
		--rose-soft: oklch(72% 0.16 12 / 0.45);
		--mx: 70%;
		--my: 40%;
		position: relative;
		isolation: isolate;
		display: grid;
		grid-template-columns: 100%;
		align-items: center;
		gap: 1rem;
		padding-bottom: 1rem;
	}

	.backdrop {
		position: absolute;
		inset: -4rem -50vw;
		z-index: -1;
		overflow: hidden;
		pointer-events: none;
		mask-image: linear-gradient(to bottom, black 60%, transparent);
	}
	.blob {
		position: absolute;
		width: 32rem;
		aspect-ratio: 1;
		border-radius: 50%;
		filter: blur(80px);
		opacity: 0.35;
	}
	.blob-a {
		left: calc(50% - 10rem);
		top: -6rem;
		background: var(--rose);
		animation: drift-a 18s ease-in-out infinite alternate;
	}
	.blob-b {
		left: calc(50% + 6rem);
		top: 6rem;
		background: oklch(80% 0.12 50);
		opacity: 0.25;
		animation: drift-b 22s ease-in-out infinite alternate;
	}
	.spotlight {
		position: absolute;
		inset: 0;
		background: radial-gradient(28rem circle at calc(var(--mx) + 50vw) calc(var(--my) + 4rem), var(--rose-soft), transparent 60%);
		opacity: 0.35;
	}
	/* Light backgrounds show the same blur far more saturated; tone it down. */
	:global([data-theme='light']) .blob-a {
		opacity: 0.16;
	}
	:global([data-theme='light']) .blob-b {
		opacity: 0.14;
	}
	:global([data-theme='light']) .spotlight {
		opacity: 0.18;
	}

	.visual {
		width: min(70%, 20rem);
		margin-inline: auto;
		perspective: 800px;
	}
	.visual svg {
		display: block;
		width: 100%;
		height: auto;
		transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
		transition: transform 0.4s ease-out;
	}
	.phones {
		transform-origin: 256px 240px;
		animation: float 6s ease-in-out infinite;
		filter: drop-shadow(0 12px 28px oklch(55% 0.22 12 / 0.45));
	}
	.pulse {
		stroke: var(--rose);
		stroke-width: 2;
		transform-origin: 256px 256px;
		animation: pulse 3.6s ease-out infinite;
	}
	.orbit {
		stroke: var(--rose);
		stroke-opacity: 0.3;
		stroke-width: 1.5;
		stroke-dasharray: 6 10;
	}
	.orbit,
	.orbit-dot {
		transform-origin: 256px 256px;
		animation: spin 24s linear infinite;
	}
	.orbit-dot {
		fill: var(--rose);
	}
	.bar {
		fill: var(--rose);
		transform-box: fill-box;
		transform-origin: bottom;
		animation: eq 1.1s ease-in-out infinite alternate;
	}

	.stack {
		flex-direction: column;
		gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
		text-align: center;
	}
	.copy {
		flex-direction: column;
		gap: 1rem;
		align-items: center;
	}
	.copy > * {
		max-width: 50ch;
	}
	h1 {
		font-size: clamp(var(--sl-text-4xl), calc(0.5rem + 6vw), 4.5rem);
		line-height: 1.05;
		font-weight: 700;
		letter-spacing: -0.03em;
		background: linear-gradient(100deg, var(--sl-color-white) 20%, var(--rose) 45%, oklch(80% 0.12 30) 55%, var(--sl-color-white) 80%);
		background-size: 250% 100%;
		background-clip: text;
		-webkit-background-clip: text;
		color: transparent;
		animation: shimmer 8s ease-in-out infinite;
	}
	.tagline {
		font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
		color: var(--sl-color-gray-2);
	}
	.actions {
		gap: 1rem 2rem;
		flex-wrap: wrap;
		justify-content: center;
	}
	.actions :global(.sl-link-button.primary) {
		background: linear-gradient(135deg, oklch(74% 0.15 12), oklch(66% 0.19 10));
		border-color: transparent;
		color: white;
		box-shadow: 0 6px 24px -6px oklch(60% 0.22 12 / 0.6);
		transition: transform 0.2s, box-shadow 0.2s;
	}
	.actions :global(.sl-link-button.primary:hover) {
		transform: translateY(-2px);
		box-shadow: 0 10px 32px -6px oklch(60% 0.22 12 / 0.8);
	}

	@media (min-width: 50rem) {
		.hero {
			grid-template-columns: 7fr 4fr;
			gap: 3%;
			padding-block: clamp(2.5rem, calc(1rem + 10vmin), 10rem);
		}
		.visual {
			order: 2;
			width: min(100%, 25rem);
		}
		.stack {
			text-align: start;
		}
		.copy {
			align-items: flex-start;
		}
		.actions {
			justify-content: flex-start;
		}
	}

	@keyframes drift-a {
		to { transform: translate(-6rem, 4rem) scale(1.15); }
	}
	@keyframes drift-b {
		to { transform: translate(5rem, -3rem) scale(0.9); }
	}
	@keyframes float {
		50% { transform: translateY(-10px); }
	}
	@keyframes pulse {
		from { transform: scale(0.75); opacity: 0.7; }
		to { transform: scale(1.45); opacity: 0; }
	}
	@keyframes spin {
		to { transform: rotate(360deg); }
	}
	@keyframes eq {
		from { transform: scaleY(0.25); }
		to { transform: scaleY(1); }
	}
	@keyframes shimmer {
		0%, 100% { background-position: 100% 0; }
		50% { background-position: 0% 0; }
	}

	@media (prefers-reduced-motion: reduce) {
		.hero *,
		h1 {
			animation: none !important;
			transition: none !important;
		}
	}
</style>
