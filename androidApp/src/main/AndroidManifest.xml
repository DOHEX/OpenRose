<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <queries>
        <package android:name="com.android.bluetooth" />
    </queries>
    <application
        android:name=".OpenRoseApplication"
        android:allowBackup="false"
        android:label="OpenRose"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <provider android:name="io.github.libxposed.service.XposedProvider" tools:node="remove" />
        <provider
            android:name=".bridge.GuardedXposedProvider"
            android:authorities="${applicationId}.XposedService"
            android:directBootAware="true"
            android:exported="true" />
        <service
            android:name=".bridge.ControlBridgeService"
            android:exported="true"
            android:directBootAware="true"
            android:stopWithTask="false" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
