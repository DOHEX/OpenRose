<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.software.companion_device_setup" android:required="false" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Waking ordinary background control after the process is gone or the phone restarted (#78). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
    <queries>
        <package android:name="com.android.bluetooth" />
        <package android:name="com.xiaomi.bluetooth" />
        <package android:name="com.milink.service" />
    </queries>
    <application
        android:name=".OpenRoseApplication"
        android:allowBackup="false"
        android:label="OpenRose"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <provider android:name="io.github.libxposed.service.XposedProvider" tools:node="remove" />
        <provider
            android:name=".bridge.GuardedXposedProvider"
            android:authorities="${applicationId}.XposedService"
            android:directBootAware="true"
            android:exported="true" />
        <!-- Ordinary background control: a connected-device foreground service, never exported. -->
        <service
            android:name=".ControlService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"
            android:stopWithTask="false" />
        <!--
            Wakes OpenRose when no process exists: the first unlock of a boot and an audio connection of a
            supported earphone. The Bluetooth broadcasts come from the Bluetooth app, not the system UID, so the
            receiver must be exported; it only asks the application to start its own service after checking the
            saved settings, and a stopped (force-stopped) package receives nothing.
        -->
        <receiver android:name=".OrdinaryWakeReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.bluetooth.a2dp.profile.action.CONNECTION_STATE_CHANGED" />
                <action android:name="android.bluetooth.headset.profile.action.CONNECTION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- Device presence of an associated earphone (Android 12+); the system binds it even without a process. -->
        <service
            android:name=".OpenRoseCompanionService"
            android:exported="true"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE"
            tools:targetApi="31">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
